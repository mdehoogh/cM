#!/bin/bash

# MDH@21OCT2019: assuming that the M source files are in subfolder src/ now and the library files to link in the current directory as we would expect after a make

# the actual stuff
# remove M so if we fail we'd know it

# will copy the static libraries to the lib folder (if the lib folder does not yet exist)
if [[ ! -d lib ]]; then
    if [[ ! -f lib ]]; then
        mkdir lib
        if [[ -d lib ]]; then
            echo "lib subdirectory created..."
        else
            echo "ERROR: Failed to create the lib subdirectory!"
            exit 1
        fi
    else
        echo "A file called lib already exists. Cannot create the subdirectory..."
        exit 1
    fi
fi

# ASSERT the lib subdirectory should now exist

#echo "Copying tommath.h from the libtommath subdirectory."
#cp libtommath/tommath.h .

# copy the library files over if present in the current directory after which we remove them
# NOTE we will copy them over instead of moving, so we do not have to recreate them every time, wait a minute if they are already present in lib leave it
# NOTE this means that this will happen once directly after a make (technically Mcompile would replace making src/Makefile)
if [[ ! -f lib/libmpdec.a ]]; then
    if [[ -f libmpdec.a.arm64 ]]; then
        echo "Copying libmpdec.a.arm64 to the lib subdirectory."
        cp libmpdec.a.arm64 lib/libmpdec.a
    else
        if [[ -f libmpdec.a ]]; then
            echo "Moving libmpdec.a to the lib subdirectory."
            mv libmpdec.a lib/
        fi
    fi
    if [[ ! -f lib/libmpdec.a ]]; then
        echo "ERROR: No libmpdec.a in the lib subdirectory."
        exit 1
    fi
fi

# MDH@12SEP2026: let's use preference library if available
if [[ ! -f lib/libtommath.a ]]; then
    if [[ -f libtommath.a.arm64 && ! -f lib/libtommath.a ]]; then
        echo "Copying libtommath.a.arm64 to the lib sudirectory."
        cp libtommath.a.arm64 lib/libtommath.a
    else
        if [[ -f libtommath.a && ! -f lib/libtommath.a ]]; then
          echo "Moving libtommath.a to the lib subdirectory."
          mv libtommath.a lib/
        fi
    fi
    if [[ ! -f lib/libtommath.a ]]; then
        echo "ERROR: No libtommath.a not present in the lib subdirectory."
        exit 1
    fi
fi

# the static libraries should now be present in the lib folder
if [[ ! -f lib/libmpdec.a || ! -f lib/libtommath.a ]]; then
    echo "ERROR: Static libraries as needed by M not present in the lib subdirectory."
    exit 1
fi

#cd src
if [[ -f tommath-1.3.1.h ]]; then
    echo "Copying tommath-1.3.1.h to the src subdirectory."
    cp tommath-1.3.1.h src/tommath.h
else
    if [[ -f M.tommath-1.1.0.h ]]; then
        echo "Copying M.tommath-1.1.0.h to the src subdirectory."
        cp M.tommath-1.1.0.h src/tommath.h
    fi
fi

# MDH@25JAN2024: we should do the same with mpdecimal.h
if [[ -f mpdecimal-4.0.1.h ]]; then
    echo "Copying mpdecimal-4.0.1.h to the src subdirectory."
    cp mpdecimal-4.0.1.h src/mpdecimal.h
else
    if [[ -f mpdecimal-2.4.2.h ]]; then
        echo "Copying mpdecimal-2.4.2.h to the src subdirectory."
        cp mpdecimal-2.4.2.h src/mpdecimal.h
    else
        echo "WARNING: No mpdecimal header file to copy to the src subdirectory."
    fi
fi 

cd src
if [[ ! -f tommath.h || ! -f mpdecimal.h ]]; then
    echo "ERROR: Either tommath.h and/or mpdecimal.h not present in the src subdirectory."
    exit 1
fi

echo ""
echo "Compiling M..."

# remove M
rm -f M
# remove all object files
rm -f *.o
# and any libM library
rm -f libM.*

# move the static libraries in here
cp ../lib/* .
# make all files readable
chmod 644 *
# MDH@28FEB2020: we can do this in pieces creating the static library on the go
# MDH@03MAR2020: compile with the -g flag so we can debug it
cc -std=c2x -Wall -Wno-incompatible-pointer-types-discards-qualifiers -Wincompatible-pointer-types -g -c Mmodule.c Moutput.c Mmessage.c Malloc.c Mchars.c Mstring.c Mjson.c Msettings.c Mtoken.c Mmemory.c Mexecution.c Mbiginteger.c Mrational.c Mdecimal.c Mvalue.c Msystem.c Mtime.c Miterator.c Marray.c Mlist.c Moperations.c Mmatrix.c Mlocale.c Mfunctions.c Menvironment.c Mshell.c 
ar cvq libM.a *.o
# compile the M interactive session source files separately
cc -std=c2x -Wall -Wno-incompatible-pointer-types-discards-qualifiers -Wincompatible-pointer-types -g -c Mcolors.c Msession.c M.c
# then link the lot together to create the interactive M program (force use the static library)
cc -std=c2x -Wall -Wno-incompatible-pointer-types-discards-qualifiers -Wincompatible-pointer-types -L. -ltommath -lmpdec -lM Mcolors.o Msession.o M.o -o M 

# check whether it is there!!!
if [ -f M ]; then
    # ascertain to be able to run it (when being sudo run)
    if [[ "$EUID" = 0 ]]; then
        chmod 755 M
        echo "M has been created!"
    else
        echo "M has been created but you may not be able to run it with ./M if the next command (chmod) fails."
        chmod 755 M
    fi
    # copy M one directory up
    if [ -f ../M ]; then
        mv -f ../M ../Mprev
        echo "Previous M copied to Mprev..."
    fi
    cp M ..
    cd ..
    if [ -f M ]; then
        echo "Executing ./M to run M now."
	./M
    else
        echo "M vanished. You will have to copy it from the scr subdirectory yourself manually."
    fi
else
    echo "ERROR: Failed to create the M executable!"
    cd ..
    if [ -f M ]; then
        echo "You have to keep using the previously created one."
    else
        echo "Too bad. Please try again!"
    fi
fi
