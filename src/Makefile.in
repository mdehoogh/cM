	-rm -f ./$(DEPDIR)/M-Mexpression.Po
	-rm -f ./$(DEPDIR)/M-Mfunctions.Po
	-rm -f ./$(DEPDIR)/M-Mmemory.Po
	-rm -f ./$(DEPDIR)/M-Moutput.Po
	-rm -f ./$(DEPDIR)/M-Mrational.Po
	-rm -f ./$(DEPDIR)/M-Msession.Po
	-rm -f ./$(DEPDIR)/M-Msettings.Po
	-rm -f ./$(DEPDIR)/M-Mstring.Po
	-rm -f ./$(DEPDIR)/M-Mvalue.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-tags

